source "https://rubygems.org"

# Same Jekyll version and plugin set as the GitHub Pages build
gem "github-pages", group: :jekyll_plugins

# Needed by `jekyll serve` on Ruby 3+
gem "webrick"

# Windows-only helpers for local preview
platforms :windows do
  gem "tzinfo", ">= 1", "< 3"
  gem "tzinfo-data"
  gem "wdm", ">= 0.2.0"
end
